# ─── MusicaPrivada · plantilla de configuración ─────────────────────────────
# Copia este archivo a .env (o ejecuta "npm run setup") y rellena los valores.
# .env NUNCA debe subirse al repositorio (está en .gitignore).

# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
# Proxies de confianza para req.ip / req.secure. "loopback" si el túnel
# (cloudflared, nginx...) corre en la misma máquina; un número = saltos.
TRUST_PROXY=loopback
# Orígenes permitidos por CORS (separados por coma). Vacío = mismo origen.
CORS_ORIGINS=

# Usuarios: "usuario:hashBcrypt" separados por coma.
# Genera cada entrada con:  npm run hash-password -- <usuario>
# FASE 2: solo SIEMBRAN la tabla `users` (se copian si no existen; nunca
# sobrescriben una contraseña cambiada desde la app). Después puede vaciarse y
# gestionar los usuarios con:  npm run user -- list|add|passwd|role|remove
APP_USERS=
# Administradores (log completo del sistema en /api/logs). Se aplica en cada arranque.
ADMIN_USERS=
# Propietario de archivos sueltos heredados en music/ y .ai_music/ (migración única).
LEGACY_OWNER=
# Duración de la sesión (días, renovación deslizante).
SESSION_TTL_DAYS=30
# Cookie de sesión con flag Secure: auto | true | false
COOKIE_SECURE=auto

# Token compartido con el worker de subtítulos (Whisper en el PC).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBTITLE_WORKER_TOKEN=

# Transcripción local con faster-whisper (whisper/transcribe.py). Se activa sola
# si existe whisper/.venv; TRANSCRIBE_LOCAL=0 vuelve al worker remoto del PC.
# Instalación: python3 -m venv whisper/.venv && whisper/.venv/bin/pip install faster-whisper
# Relleno de canciones existentes: node scripts/transcribe-backfill.js --limite N
# TRANSCRIBE_LOCAL=
# WHISPER_MODEL=small          # base si la máquina va justa
# WHISPER_COMPUTE_TYPE=int8
# WHISPER_THREADS=3
# WHISPER_NICE=19

# Importación de Spotify sin navegador (FASE 2). Opcional: sin credenciales se
# usa el reproductor embebido público (máx. ~100 pistas por playlist). Crea una
# app gratuita en https://developer.spotify.com/dashboard para leerlas completas.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=ES

# APIs externas (claves NUEVAS: las anteriores estaban publicadas y deben revocarse)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LASTFM_API_KEY=

# Rutas (relativas a la raíz del proyecto)
MUSIC_DIR=music
AI_MUSIC_DIR=.ai_music
DB_PATH=database.sqlite
LOG_FILE=downloads.log
LOG_MAX_BYTES=5242880
LOG_MAX_FILES=3
# Nivel mínimo: debug | info | warn | error. Formato: text | json.
LOG_LEVEL=info
LOG_FORMAT=text

# Cabeceras de seguridad: true = la CSP solo informa (para depurar), no bloquea.
CSP_REPORT_ONLY=false
# Reintentos de una importación/descarga interrumpida por un reinicio.
JOB_MAX_ATTEMPTS=3
# Driver SQLite: vacío = better-sqlite3 (si falta, node:sqlite de Node ≥ 22.13).
SQLITE_DRIVER=

# Límite de ancho de banda por stream en KB/s (0 = sin límite).
STREAM_THROTTLE_KBPS=0
# Tamaño máximo del cuerpo JSON (importaciones grandes).
JSON_LIMIT=10mb
# Días que se conservan las recomendaciones IA rechazadas/saltadas.
AI_ARCHIVE_RETENTION_DAYS=7
# Al arrancar, las recomendaciones IA que llevan más de estos días en 'pending'
# (descarga interrumpida por un reinicio) pasan a 'failed'; las recientes se reanudan.
AI_PENDING_MAX_AGE_DAYS=3
# Una recomendación 'pending'/'failed' de más de estos días se puede volver a proponer.
AI_RETRY_AFTER_DAYS=14
# Minutos de espera tras una generación de recomendaciones que no trajo nada nuevo.
AI_EMPTY_COOLDOWN_MINUTES=60
# Géneros: días hasta volver a intentar una canción no reconocida, y máximo de
# peticiones diarias a Gemini para clasificar (la cuota gratuita es compartida).
GENRE_RECHECK_DAYS=30
GENRE_GEMINI_DAILY_LIMIT=6
# Rutas opcionales a binarios
YTDLP_PATH=
FFPROBE_PATH=
# Copias de seguridad a conservar (npm run backup)
BACKUP_KEEP=10

# ─── Herramientas de despliegue (tools/remote_ops.py) ───────────────────────
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PORT=22
# Clave SSH privada (autenticación por contraseña desactivada en las herramientas)
DEPLOY_KEY_FILE=
DEPLOY_REMOTE_DIR=/home/usuario/spotify/musicaPrivada
DEPLOY_PM2_APP=musica-privada

# Solo para tools/sync_repo.js (token de GitHub de grano fino, solo lectura)
GITHUB_TOKEN=
GITHUB_REPO=
